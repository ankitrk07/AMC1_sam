generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  countryCode String?
  source      String
  sourceOther String?
  createdAt   DateTime @default(now())
}

model Booking {
  id                    String        @id @default(cuid())
  name                  String?
  phone                 String?
  countryCode           String?
  preferredDate         String?
  selectedSlot          String?
  selectedCounsellor    String?
  selectedCounsellorUrl String?
  calendlyEventUri      String?       @unique
  scheduledStartTime    DateTime?
  scheduledEndTime      DateTime?
  calendlyEventName     String?
  status                BookingStatus @default(PENDING)
  timezone              String?
  notes                 String?
  googleMeetUrl         String?
  locationType          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
