# ─────────────────────────────────────────────────────────────
# AMC by DRG — environment configuration
#
# Copy to .env and fill in real values.
#
# EVERY key the application reads is listed here. If a key is missing from
# .env, the startup environment check prints it as MISSING; if it is one of
# the REQUIRED keys the server refuses to start rather than silently running
# a different code path. (An absent DATABASE_URL used to switch the app into
# a JSON-only mode, which is why the laptop and the server behaved
# differently — see AUDIT.md.)
# ─────────────────────────────────────────────────────────────

# ── REQUIRED — the server will not start without these ──────

# PostgreSQL connection string. The single source of truth for leads and
# bookings. Local development points at a local PostgreSQL instance; the
# server points at its own database.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amc1_sam?schema=public"

# Shared secret protecting every /api/admin/* route and the admin panel.
# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is missing the server refuses to start — the admin API must never
# fail open, because it exposes every lead's name, email and phone.
ADMIN_API_KEY=change_me_to_a_long_random_secret

# ── OPTIONAL — the server starts without these, with reduced function ──

# HTTP port (defaults to 3000).
PORT=3000

# Counsellor 1 Calendly settings.
# The token is a Calendly personal access token; the URL must exactly match
# one of that account's event-type scheduling URLs.
CALENDLY_API_TOKEN_1=your_token_1_here
CALENDLY_URL_1=https://calendly.com/your_user/15-minute-consultation

# Counsellor 2 Calendly settings.
# A rejected token here no longer takes down availability for counsellor 1 —
# each counsellor is resolved independently — but that counsellor's slots
# will be missing until it is fixed.
CALENDLY_API_TOKEN_2=your_token_2_here
CALENDLY_URL_2=https://calendly.com/another_user/15-minute-consultation

# Timezone used to render slots, and the matching UTC offset used to build
# day ranges (e.g. +05:30 for Indian Standard Time).
CALENDLY_TIMEZONE=Asia/Kolkata
CALENDLY_TIMEZONE_OFFSET=+05:30

# Brevo (Sendinblue) transactional email key.
# Without it the app runs in offline email mode: confirmation emails are
# logged to the console instead of sent.
BREVO_API_KEY=your_brevo_key_here
